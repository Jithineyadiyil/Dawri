# ────────────────────────────────────────────────────────────────────
#  SPRINT 15 — DAWRI COMMUNITY (.env additions)
#  Append these lines to:  D:\xamp new\htdocs\Dawri\backend\.env
# ────────────────────────────────────────────────────────────────────

# Broadcasting driver — must be "reverb" for real-time messaging.
# This is the same Reverb config from Sprint 6 (browser broadcasting).
# Confirm these exist in your .env; do NOT duplicate:
BROADCAST_CONNECTION=reverb

# Reverb (re-uses Sprint 6 setup — listed here for completeness)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Optional: tweak rate limits via env (defaults set in routes)
COMMUNITY_POST_RATE=30
COMMUNITY_REACT_RATE=60

# After editing .env:
#   D:\xamp new\htdocs\Dawri\backend>  php artisan config:clear
